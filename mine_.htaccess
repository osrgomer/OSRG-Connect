RewriteEngine On

# 1. Remove .php extension from visible URLs (redirect to pretty)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Map pretty URLs back to .php files internally
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L]

# 3. Handle index specifically
DirectoryIndex index.php
